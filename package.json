{
  "name": "fsd-nuxt-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "fsd:check": "steiger ./app",
    "ci": "npm run fsd:check && npm run lint && npm run typecheck && npm run build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "audit": "node scripts/audit-production.mjs",
    "test:audit-policy": "node --test tests/audit-policy.test.mjs",
    "postinstall": "nuxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "@tanstack/vue-query": "^5.107.1",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "steiger": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
